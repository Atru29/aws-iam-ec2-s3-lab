{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarSoloMiBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::tecsup-class-arturo-20261125"
    },
    {
      "Sid": "LeerEscribirBorrarObjetosDeMiBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::tecsup-class-arturo-20261125/*"
    }
  ]
}
